{
  "model": {
    "vocab_size": 256,
    "context_length": 128,
    "embedding_dim": 128,
    "num_layers": 4,
    "num_heads": 4,
    "dropout": 0.1
  },
  "data": {
    "data_path": "data/tiny_shakespeare.txt",
    "tokenizer_type": "byte"
  },
  "train": {
    "learning_rate": 0.0003,
    "batch_size": 32,
    "num_steps": 3000,
    "warmup_steps": 150,
    "eval_every": 250,
    "sample_every": 250,
    "log_every": 50
  },
  "checkpoint_dir": "checkpoints/mini",
  "run_name": "a2lm-mini"
}