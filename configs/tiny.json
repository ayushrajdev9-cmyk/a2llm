{
  "model": {
    "vocab_size": 256,
    "context_length": 32,
    "embedding_dim": 32,
    "num_layers": 2,
    "num_heads": 2,
    "dropout": 0.05
  },
  "data": {
    "data_path": "data/tiny_shakespeare.txt",
    "tokenizer_type": "byte"
  },
  "train": {
    "learning_rate": 0.003,
    "batch_size": 32,
    "num_steps": 3000,
    "warmup_steps": 100,
    "eval_every": 300,
    "sample_every": 300,
    "log_every": 50
  },
  "checkpoint_dir": "checkpoints/nano",
  "run_name": "a2lm-nano"
}